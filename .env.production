# ============================================================================
# Bitácora — configuración de producción
# ----------------------------------------------------------------------------
# Estos dos valores NO son secretos. En una app de Next.js toda variable
# NEXT_PUBLIC_* acaba dentro del JavaScript que se envía al navegador, así que
# cualquiera que visite la web puede leerlos de todas formas. Supabase los
# publica con ese propósito: quien protege los datos son las políticas RLS,
# no la clave. El único valor que sí es secreto es la clave `service_role`,
# que esta aplicación no usa en ningún sitio.
#
# Si algún día cambian, se pueden sobrescribir desde Vercel (Project Settings >
# Environment Variables) sin tocar el código: las variables de Vercel tienen
# prioridad sobre este fichero.
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://bbxyvhcolypgvxtfsyvy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dVTJXqQeZ1NOckh7jSvT2g_YMKohENu

# Dominios de correo autorizados, separados por comas (p. ej. decasight.com).
# Vacío = sin restricción por dominio. Aun así, solo entra quien esté dado de
# alta en Supabase: el registro público está cerrado.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=
